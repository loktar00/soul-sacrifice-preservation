# ALLOWLIST: ignore everything, then re-include only our own code and docs.
# Never commit: game files (dump, archives, unpacked members, decrypted ELFs, Ghidra DB), the .rif license,
# Sony firmware, generated key tables, third-party tools, emulator storage, logs (they can contain the zRIF).
/*
!/.gitignore
!/README.md
!/NOTES.md
!/tasks/

!/port/
/port/*

!/port/modkit/
/port/modkit/build/
/port/modkit/mods/*/files/

!/port/tools/
/port/tools/*
!/port/tools/vpad.py
!/port/tools/shot.ps1
!/port/tools/pk/
!/port/tools/re/
/port/tools/re/sceutils3/keys.py

!/port/re/
/port/re/*
!/port/re/ghidra/
/port/re/ghidra/*
!/port/re/ghidra/README.md
!/port/re/ghidra/scripts/
!/port/re/ghidra/*.bat
!/port/re/recomp/
/port/re/recomp/measure/out/
!/port/re/netplay/
/port/re/netplay/out/

!/port/build/
/port/build/*
!/port/build/BUILD.md
!/port/build/*.bat
!/port/build/*.patch

!/port/notes/
/port/notes/*
!/port/notes/*.md
!/port/notes/original_files.txt

__pycache__/
*.pyc
*.log
*.png
*.rif
*.bin
*.pk
*.pkh
*.pfs
*.elf
*.PUP
